const { app, BrowserWindow, ipcMain } = require('electron');
const path = require('path');
const { spawn, fork } = require('child_process');
const fs = require('fs');

let mainWindow;
let codegenProcess = null;
let replayProcess = null;

// 鈹€鈹€ 杈呭姪鍑芥暟锛氳繍琛?Node.js 鑴氭湰锛堜笉渚濊禆绯荤粺 Node.js锛夆攢鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function runNodeScript(scriptPath, args, options = {}) {
    // 浣跨敤 Electron 鍐呯疆鐨?Node.js 杩愯鏃?    // 璁剧疆 ELECTRON_RUN_AS_NODE=1 璁?electron.exe 浠?Node.js 妯″紡杩愯
    const env = { 
        ...process.env, 
        ...options.env,
        ELECTRON_RUN_AS_NODE: '1' 
    };
    
    console.log('[runNodeScript] 鍚姩瀛愯繘绋?');
    console.log('  - execPath:', process.execPath);
    console.log('  - scriptPath:', scriptPath);
    console.log('  - args:', args);
    console.log('  - cwd:', options.cwd || __dirname);
    console.log('  - ELECTRON_RUN_AS_NODE:', env.ELECTRON_RUN_AS_NODE);
    
    const childProcess = spawn(process.execPath, [scriptPath, ...args], {
        cwd: options.cwd || __dirname,
        stdio: options.stdio || ['ignore', 'pipe', 'pipe'],
        windowsHide: options.windowsHide !== false,
        env: env
    });
    
    childProcess.on('error', (err) => {
        console.error('[runNodeScript] 杩涚▼鍚姩澶辫触:', err);
    });
    
    return childProcess;
}

// Session data
let session = {
    id: null,
    dir: null,
    url: '',
    uiScript: '',
    harApis: [],
    semanticScript: '',
    apiScript: '',
    step: 'record'  // record | ui-debug | semantic | api-generate | api-debug
};

function createWindow() {
    mainWindow = new BrowserWindow({
        width: 1400,
        height: 900,
        webPreferences: {
            nodeIntegration: true,
            contextIsolation: false
        }
    });
    mainWindow.loadFile('index-main.html');
    if (process.argv.includes('--dev')) {
        mainWindow.webContents.openDevTools();
    }
}

app.whenReady().then(() => {
    createWindow();
    
    // 鑷姩鍒濆鍖?session锛屼娇鐢ㄥ浐瀹氱殑 ui-recorder-workspace 鐩綍
    const workspaceRoot = path.join(__dirname, '..');
    const dir = path.join(workspaceRoot, 'ui-recorder-workspace');
    fs.mkdirSync(dir, { recursive: true });
    
    session = {
        id: `session-auto-${Date.now()}`,
        dir,
        url: '',
        uiScript: '',
        harApis: [],
        semanticScript: '',
        apiScript: '',
        seedData: null,
        step: 'record'
    };
    
    console.log(`[Auto Init] Session initialized, dir: ${dir}`);
    
    app.on('activate', () => {
        if (BrowserWindow.getAllWindows().length === 0) createWindow();
    });
});

app.on('window-all-closed', () => {
    cleanup();
    if (process.platform !== 'darwin') app.quit();
});

function cleanup() {
    if (codegenProcess) { codegenProcess.kill(); codegenProcess = null; }
    if (replayProcess)  { replayProcess.kill();  replayProcess = null; }
}

// 鈹€鈹€ Create session 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('create-session', (event, url) => {
    const id = `session-${Date.now()}`;
    // 鍥哄畾鏀惧湪宸ヤ綔鍖烘牴鐩綍鐨?ui-recorder-workspace 涓嬶紝Kiro 鍙互鐩存帴璇诲啓
    const workspaceRoot = path.join(__dirname, '..'); // ceta-ai-skills 鏍圭洰褰?    const dir = path.join(workspaceRoot, 'ui-recorder-workspace');
    fs.mkdirSync(dir, { recursive: true });

    session = {
        id,
        dir,
        url,
        uiScript: '',
        harApis: [],
        semanticScript: '',
        apiScript: '',
        seedData: null,
        step: 'record'
    };

    console.log(`Session created: ${id}, dir: ${dir}`);
    event.reply('session-created', { id, dir });
});

// 鈹€鈹€ Upload seed data 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('upload-seed-data', (event, data) => {
    if (!session || !session.dir) {
        console.error('[Seed Data] No active session');
        return;
    }

    const seedDataPath = path.join(session.dir, 'seed-data.json');
    fs.writeFileSync(seedDataPath, data.content, 'utf-8');
    
    session.seedData = JSON.parse(data.content);
    console.log(`[Seed Data] Saved to: ${seedDataPath}`);
    
    event.reply('seed-data-saved', { path: seedDataPath });
});

// 鈹€鈹€ Generate API Documentation 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('generate-api-doc', (event) => {
    if (!session || !session.dir || !session.seedData) {
        console.error('[API Doc] No seed data available');
        return;
    }

    const contextFile = path.join(session.dir, 'api-doc-context.md');
    const docFile = path.join(session.dir, 'api-documentation.md');

    const lines = [];
    lines.push('# CETA API 鏂囨。鐢熸垚璇锋眰');
    lines.push('');
    lines.push(`**鏃堕棿**: ${new Date().toLocaleString('zh-CN')}`);
    lines.push(`**杈撳嚭鏂囦欢**: \`${docFile}\``);
    lines.push('');
    lines.push('## 椤圭洰淇℃伅');
    lines.push('');
    
    if (session.seedData.project) {
        lines.push(`**椤圭洰鍚嶇О**: ${session.seedData.project.name || '鏈懡鍚?}`);
        lines.push(`**椤圭洰 Token**: ${session.seedData.project.token || 'N/A'}`);
        if (session.seedData.project.description) {
            lines.push(`**椤圭洰鎻忚堪**: ${session.seedData.project.description}`);
        }
        lines.push('');
    }

    // PBC 淇℃伅
    if (session.seedData.pbcs && session.seedData.pbcs.length > 0) {
        lines.push(`## PBC 鍒楄〃 (${session.seedData.pbcs.length} 涓?`);
        lines.push('');
        session.seedData.pbcs.forEach(pbc => {
            lines.push(`### ${pbc.name} (\`${pbc.token}\`)`);
            if (pbc.description) {
                lines.push(`${pbc.description}`);
            }
            lines.push('');
        });
    }

    // 琛ㄥ崟瀹炰綋璇︾粏淇℃伅
    if (session.seedData.formEntities && session.seedData.formEntities.length > 0) {
        lines.push(`## 琛ㄥ崟瀹炰綋 (${session.seedData.formEntities.length} 涓?`);
        lines.push('');
        session.seedData.formEntities.forEach(fe => {
            lines.push(`### ${fe.name} (\`${fe.token}\`)`);
            if (fe.pbcToken) {
                lines.push(`**鎵€灞?PBC**: \`${fe.pbcToken}\``);
            }
            if (fe.description) {
                lines.push(`**鎻忚堪**: ${fe.description}`);
            }
            lines.push('');
            
            if (fe.fields && fe.fields.length > 0) {
                lines.push('**瀛楁鍒楄〃**:');
                lines.push('');
                lines.push('| 瀛楁鍚?| Token | 绫诲瀷 | 蹇呭～ | 鎻忚堪 |');
                lines.push('|--------|-------|------|------|------|');
                fe.fields.forEach(field => {
                    const name = field.name || field.label || '-';
                    const token = field.token || '-';
                    const type = field.type || field.fieldType || '-';
                    const required = field.required ? '鏄? : '鍚?;
                    const desc = field.description || '-';
                    lines.push(`| ${name} | \`${token}\` | ${type} | ${required} | ${desc} |`);
                });
                lines.push('');
            }
        });
    }

    // 椤甸潰閰嶇疆淇℃伅
    if (session.seedData.pages && session.seedData.pages.length > 0) {
        lines.push(`## 椤甸潰閰嶇疆 (${session.seedData.pages.length} 涓?`);
        lines.push('');
        session.seedData.pages.forEach(page => {
            lines.push(`### ${page.name} (\`${page.schemaId}\`)`);
            if (page.description) {
                lines.push(`${page.description}`);
            }
            if (page.pbcToken) {
                lines.push(`**鎵€灞?PBC**: \`${page.pbcToken}\``);
            }
            lines.push('');
        });
    }

    // 娴佺▼瀹氫箟淇℃伅
    if (session.seedData.flowDefinitions && session.seedData.flowDefinitions.length > 0) {
        lines.push(`## 娴佺▼瀹氫箟 (${session.seedData.flowDefinitions.length} 涓?`);
        lines.push('');
        session.seedData.flowDefinitions.forEach(flow => {
            lines.push(`### ${flow.name} (\`${flow.token}\`)`);
            if (flow.description) {
                lines.push(`${flow.description}`);
            }
            if (flow.pbcToken) {
