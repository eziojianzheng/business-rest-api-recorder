    lines.push('');
    lines.push('**鏂板璁板綍娴佺▼**:');
    lines.push('1. 鑾峰彇琛ㄥ崟甯冨眬閰嶇疆锛堜簡瑙ｉ渶瑕佸～鍐欏摢浜涘瓧娈碉級');
    lines.push('2. 鍔犺浇鍏宠仈瀛楁鐨勯€夐」鍒楄〃锛堝鏁版嵁瀛楀吀銆佷富鏁版嵁锛?);
    lines.push('3. 鐢ㄦ埛濉啓琛ㄥ崟');
    lines.push('4. 鎻愪氦鍒涘缓璇锋眰锛屼紶閫掑畬鏁寸殑瀛楁鍊?);
    lines.push('5. 杩斿洖鍒楄〃椤碉紝鍒锋柊鏁版嵁');
    lines.push('');
    lines.push('**鍒楄〃鏌ヨ娴佺▼**:');
    lines.push('1. 鑾峰彇椤甸潰閰嶇疆锛堝垪瀹氫箟銆佺瓫閫夊櫒閰嶇疆锛?);
    lines.push('2. 璋冪敤鍒楄〃鎺ュ彛锛屼紶閫掑垎椤靛弬鏁板拰绛涢€夋潯浠?);
    lines.push('3. 娓叉煋鍒楄〃鏁版嵁');
    lines.push('');
    lines.push('### 5. 甯歌闂鍜屾敞鎰忎簨椤?);
    lines.push('');
    lines.push('- **鍏宠仈瀛楁鐨勬暟鎹粨鏋?*: 璇存槑鍏宠仈瀛楁锛堝 `userField`銆乣factory`銆乣area`锛夐渶瑕佷紶閫掔殑瀹屾暣瀵硅薄缁撴瀯');
    lines.push('- **ID 鐨勮幏鍙栨柟寮?*: 璇存槑鍚勭 ID锛堣〃鍗曞疄浣?ID銆佽褰?ID銆佸叧鑱斿璞?ID锛変粠鍝噷鑾峰彇');
    lines.push('- **蹇呭～瀛楁**: 鍒楀嚭姣忎釜琛ㄥ崟瀹炰綋鐨勫繀濉瓧娈?);
    lines.push('- **瀛楁绫诲瀷杞崲**: 璇存槑鏃ユ湡銆佹暟瀛楃瓑鐗规畩绫诲瀷鐨勬牸寮忚姹?);
    lines.push('');
    lines.push('### 杈撳嚭鏍煎紡');
    lines.push('');
    lines.push('浣跨敤 Markdown 鏍煎紡锛岀粨鏋勬竻鏅帮紝鍖呭惈浠ｇ爜绀轰緥銆備繚瀛樺埌鎸囧畾鐨勮緭鍑烘枃浠躲€?);
    lines.push('');

    fs.writeFileSync(contextFile, lines.join('\n'), 'utf-8');
    console.log(`[API Doc] Context written to: ${contextFile}`);

    // 鐢熸垚瑙﹀彂璇?    const triggerMsg = `璇疯鍙?ui-recorder-workspace/api-doc-context.md锛屾寜鐓у叾涓殑瑕佹眰鐢熸垚瀹屾暣鐨?CETA API 鏂囨。骞朵繚瀛樺埌 ui-recorder-workspace/api-documentation.md`;

    event.reply('api-doc-context-ready', { triggerMsg });

    // 鐩戝惉鏂囨。鏂囦欢鐢熸垚
    startWatchingApiDoc(docFile);
});

let apiDocWatcher = null;

function startWatchingApiDoc(filePath) {
    if (apiDocWatcher) { apiDocWatcher.close(); apiDocWatcher = null; }

    const checkInterval = setInterval(() => {
        if (fs.existsSync(filePath)) {
            clearInterval(checkInterval);
            console.log('[API Doc] 鏂囨。宸茬敓鎴?);
            
            const content = fs.readFileSync(filePath, 'utf-8');
            const preview = content.substring(0, 1000); // 鍓?000瀛楃浣滀负棰勮
            
            mainWindow.webContents.send('api-doc-done', { 
                docPath: filePath,
                preview: preview 
            });
        }
    }, 1000);

    // 10鍒嗛挓鍚庡仠姝㈣疆璇?    setTimeout(() => clearInterval(checkInterval), 10 * 60 * 1000);
}


// 鈹€鈹€ Start recording 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('start-recording', async (event, url) => {
    session.url = url;
    const outputFile = path.join(session.dir, 'ui-script.js');
    const harFile    = path.join(session.dir, 'network.har');

    if (fs.existsSync(outputFile)) fs.unlinkSync(outputFile);
    if (fs.existsSync(harFile))    fs.unlinkSync(harFile);

    // 浣跨敤 Electron 鍐呯疆鐨?Node.js 杩愯鏃讹紝涓嶄緷璧栫郴缁?Node.js
    // playwright-core/cli.js 鏄?Playwright 鐨?CLI 鍏ュ彛
    const playwrightCli = path.join(__dirname, 'node_modules', 'playwright-core', 'cli.js');
    const args = [
        'codegen',
        '--output',   outputFile,
        '--save-har', harFile,
        '--target',   'playwright-test',
        '--channel',  'chrome',
        url
    ];

    codegenProcess = runNodeScript(playwrightCli, args, {
        cwd: __dirname,
        windowsHide: false
    });

    codegenProcess.stdout.on('data', d => console.log('[Codegen]', d.toString().trim()));
    codegenProcess.stderr.on('data', d => console.error('[Codegen]', d.toString().trim()));

    codegenProcess.on('close', code => {
        console.log('Codegen closed:', code);

        // Read UI script
        if (fs.existsSync(outputFile)) {
            session.uiScript = fs.readFileSync(outputFile, 'utf-8');
        }

        // Parse HAR
        if (fs.existsSync(harFile)) {
            try {
                const har = JSON.parse(fs.readFileSync(harFile, 'utf-8'));
                session.harApis = (har.log?.entries || []).map(e => ({
                    method:    e.request.method,
                    url:       e.request.url,
                    status:    e.response.status,
                    timestamp: e.startedDateTime,
                    postData:  e.request.postData?.text || null,
                    response:  e.response.content?.text || null,
                    mimeType:  e.response.content?.mimeType || ''
                }));
            } catch(e) { console.error('HAR parse error:', e); }
        }

        // Write context file for Kiro AI
        writeKiroContext();

        mainWindow.webContents.send('recording-done', {
            uiScript: session.uiScript,
            apiCount: session.harApis.length
        });
    });

    // Watch UI script file
    let lastSize = 0;
    const watchInterval = setInterval(() => {
        if (!fs.existsSync(outputFile)) return;
        const size = fs.statSync(outputFile).size;
        if (size !== lastSize) {
            lastSize = size;
            const content = fs.readFileSync(outputFile, 'utf-8');
            session.uiScript = content;
            mainWindow.webContents.send('ui-script-updated', content);
        }
    }, 1000);

    codegenProcess.on('close', () => clearInterval(watchInterval));

    await new Promise(r => setTimeout(r, 1500));
    event.reply('recording-started', { status: 'success' });
});

// 鈹€鈹€ Stop recording 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('stop-recording', (event) => {
    if (codegenProcess) { codegenProcess.kill(); codegenProcess = null; }
    event.reply('recording-stopped', {});
});

// 鈹€鈹€ Replay UI script 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('replay-ui', async (event) => {
    const scriptFile = path.join(session.dir, 'ui-script.js');
    if (!fs.existsSync(scriptFile)) {
        mainWindow.webContents.send('replay-log', { type: 'fail', msg: '鉁?鎵句笉鍒拌剼鏈枃浠讹紝璇峰厛褰曞埗' });
        mainWindow.webContents.send('replay-result', { success: false, code: 1 });
        return;
    }

    // 璇诲彇鏈€鏂拌剼鏈紝澶嶅埗鍒版湰鍦扮洰褰曡繍琛岋紙閬垮厤璺緞绌烘牸闂锛?    const script = fs.readFileSync(scriptFile, 'utf-8');
    const testFile = path.join(__dirname, 'replay-test.spec.js');
    fs.writeFileSync(testFile, script, 'utf-8');

    mainWindow.webContents.send('replay-log', { type: 'info', msg: '寮€濮嬪洖鏀?..' });
    mainWindow.webContents.send('replay-log', { type: 'info', msg: `鑴氭湰: ${scriptFile}` });

    // 浣跨敤 Electron 鍐呯疆鐨?Node.js 杩愯鏃讹紝涓嶄緷璧栫郴缁?Node.js
    const playwrightCli = path.join(__dirname, 'node_modules', '@playwright', 'test', 'cli.js');
    
    replayProcess = runNodeScript(playwrightCli, [
        'test',
        'replay-test.spec.js',
        '--config=playwright.config.js',
        '--reporter=line'
    ], {
        cwd: __dirname,
        env: { FORCE_COLOR: '0' }
    });

    replayProcess.stdout.on('data', d => {
        const msg = d.toString('utf8').trim();
        if (msg) mainWindow.webContents.send('replay-log', { type: 'stdout', msg });
    });

    replayProcess.stderr.on('data', d => {
        const msg = d.toString('utf8').trim();
        if (msg) mainWindow.webContents.send('replay-log', { type: 'stderr', msg });
    });

    replayProcess.on('close', code => {
        // 杩愯瀹屽啀鍒犻櫎涓存椂鏂囦欢
        try { fs.unlinkSync(testFile); } catch(e) {}
        const success = code === 0;
        mainWindow.webContents.send('replay-result', { success, code });
        replayProcess = null;
    });
});

// 鈹€鈹€ Stop replay 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('stop-replay', (event) => {
    if (replayProcess) { replayProcess.kill(); replayProcess = null; }
    event.reply('replay-stopped', {});
});

// 鈹€鈹€ Update UI script (from Kiro AI edits) 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('update-ui-script', (event, script) => {
    session.uiScript = script;
    const scriptFile = path.join(session.dir, 'ui-script.js');
    fs.writeFileSync(scriptFile, script, 'utf-8');
    writeKiroContext();
    event.reply('script-updated', {});
});

// 鈹€鈹€ Generate semantic script锛堢敱 Kiro AI 鐢熸垚锛夆攢鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('generate-semantic', (event) => {
    if (!session.dir) return;

    // 杩囨护涓氬姟 API锛堝幓鎺夐潤鎬佽祫婧愬拰鍣煶锛?    const businessApis = session.harApis.filter(a => {
        const u = a.url.toLowerCase();
        return (u.includes('/api/') || a.mimeType?.includes('json')) &&
               !u.match(/\.(js|css|png|jpg|svg|ico|woff|ttf|woff2|map)(\?|$)/) &&
               !u.includes('/locales/') && !u.includes('/js/') &&
               !u.includes('/css/') && !u.includes('/img/') &&
               !u.includes('/icons/') && !u.includes('/packages/') &&
               !u.includes('/translation') && !u.includes('/front-end-config') &&
               !u.includes('/pbc/list') && !u.includes('/user/captcha') &&
               !u.includes('/notice-board') && !u.includes('/bot-config') &&
               !u.includes('/user/usage') && !u.includes('/user-profile-config');
    });

    // 鍐欏叆涓婁笅鏂囨枃浠朵緵 Kiro 璇诲彇
    const contextFile = path.join(session.dir, 'semantic-context.md');
    const semFile     = path.join(session.dir, 'semantic-script.md');

    const lines = [];
    lines.push('# UI Recorder - 璇箟鑴氭湰鐢熸垚璇锋眰');
    lines.push('');
    lines.push(`**鏃堕棿**: ${new Date().toLocaleString('zh-CN')}`);
    lines.push(`**杈撳嚭鏂囦欢**: \`${semFile}\``);
    lines.push('');
    
    // 濡傛灉鏈?seed data锛屾坊鍔犻」鐩粨鏋勪俊鎭?    if (session.seedData) {
        lines.push('## 椤圭洰缁撴瀯淇℃伅锛堟潵鑷?Seed Data锛?);
        lines.push('');
        if (session.seedData.project) {
            lines.push(`**椤圭洰鍚嶇О**: ${session.seedData.project.name || '鏈懡鍚?}`);
            lines.push(`**椤圭洰 Token**: ${session.seedData.project.token || 'N/A'}`);
            if (session.seedData.project.description) {
                lines.push(`**椤圭洰鎻忚堪**: ${session.seedData.project.description}`);
            }
            lines.push('');
        }
        
        if (session.seedData.pbcs && session.seedData.pbcs.length > 0) {
            lines.push(`**PBC 鏁伴噺**: ${session.seedData.pbcs.length}`);
            lines.push('');
            lines.push('**PBC 鍒楄〃**:');
            session.seedData.pbcs.forEach(pbc => {
                lines.push(`- ${pbc.name} (\`${pbc.token}\`)`);
                if (pbc.description) {
                    lines.push(`  ${pbc.description}`);
                }
            });
            lines.push('');
        }
        
        if (session.seedData.formEntities && session.seedData.formEntities.length > 0) {
            lines.push(`**琛ㄥ崟瀹炰綋鏁伴噺**: ${session.seedData.formEntities.length}`);
            lines.push('');
            lines.push('**涓昏琛ㄥ崟瀹炰綋**锛堝墠10涓級:');
            session.seedData.formEntities.slice(0, 10).forEach(fe => {
                lines.push(`- ${fe.name} (\`${fe.token}\`)`);
                if (fe.fields && fe.fields.length > 0) {
                    const fieldNames = fe.fields.slice(0, 5).map(f => f.name || f.token).join(', ');
                    lines.push(`  瀛楁: ${fieldNames}${fe.fields.length > 5 ? ` ... (鍏?{fe.fields.length}涓?` : ''}`);
                }
            });
            lines.push('');
        }
        
        lines.push('> 馃挕 **鎻愮ず**: 鐢熸垚璇箟鑴氭湰鏃讹紝璇风粨鍚堜笂杩伴」鐩粨鏋勪俊鎭紝璇嗗埆 UI 鎿嶄綔瀵瑰簲鐨勮〃鍗曞疄浣撳拰瀛楁锛屾彁渚涙洿鍑嗙‘鐨勪笟鍔℃弿杩般€?);
        lines.push('');
    }
    
    lines.push('## UI 鑴氭湰');
    lines.push('```javascript');
    lines.push(session.uiScript || '// 鏆傛棤鑴氭湰');
    lines.push('```');
    lines.push('');
    lines.push('## 涓氬姟 API 鍒楄〃');
    lines.push(`鍏?${businessApis.length} 涓笟鍔℃帴鍙ｏ細`);
    lines.push('');
    businessApis.forEach((a, i) => {
        let pathname = a.url;
        try { pathname = new URL(a.url).pathname; } catch {}
        lines.push(`${i + 1}. \`${a.method} ${pathname}\` 鈫?${a.status}`);
        if (a.postData) {
            try {
                const data = JSON.parse(a.postData);
                const keys = Object.keys(data).slice(0, 5).join(', ');
                if (keys) lines.push(`   璇锋眰浣撳瓧娈? ${keys}`);
            } catch {}
        }
    });
    lines.push('');
    lines.push('## 浣犵殑浠诲姟');
    lines.push('');
    lines.push('璇锋牴鎹笂闈㈢殑 UI 鑴氭湰鍜屼笟鍔?API锛岀敓鎴愪竴浠?*涓氬姟璇箟鑴氭湰**锛岃姹傦細');
    lines.push('');
    lines.push('1. **鐢ㄨ嚜鐒惰瑷€鎻忚堪涓氬姟娴佺▼**锛堜笉鏄妧鏈弿杩帮紝鏄笟鍔′汉鍛樿兘鐪嬫噦鐨勶級');
    lines.push('2. **鎺ㄦ柇涓氬姟鍦烘櫙鍚嶇О**锛堝锛氭柊澧炲鐢熶俊鎭€佺敤鎴风櫥褰曘€佹煡璇㈣鍗曠瓑锛?);
    lines.push('3. **鎻忚堪姣忎釜鎿嶄綔姝ラ鐨勪笟鍔″惈涔?*锛堜笉鏄?鐐瑰嚮鎸夐挳"锛岃€屾槸"鐢ㄦ埛鍙戣捣鏂板鎿嶄綔"锛?);
    lines.push('4. **鍏宠仈 UI 鎿嶄綔鍜?API 璋冪敤**锛堣鏄庡摢涓搷浣滆Е鍙戜簡鍝釜鎺ュ彛锛?);
    lines.push('5. **鎻愬彇娴嬭瘯鏁版嵁**锛堝綍鍒舵椂鐢ㄧ殑璐﹀彿銆佸～鍐欑殑瀛楁鍊肩瓑锛?);
    if (session.seedData) {
        lines.push('6. **缁撳悎椤圭洰缁撴瀯淇℃伅**锛堣瘑鍒搷浣滃搴旂殑琛ㄥ崟瀹炰綋銆佸瓧娈靛悕绉帮紝鎻愪緵鍑嗙‘鐨勪笟鍔℃湳璇級');
    }
    lines.push('');
    lines.push('杈撳嚭鏍煎紡涓?Markdown锛屼繚瀛樺埌锛?);
    lines.push(`\`${semFile}\``);
    lines.push('');
    lines.push('淇濆瓨鍚?Electron 宸ュ叿浼氳嚜鍔ㄦ娴嬪苟鏄剧ず銆?);

    fs.writeFileSync(contextFile, lines.join('\n'), 'utf-8');
    console.log('[Semantic] 涓婁笅鏂囧凡鍐欏叆:', contextFile);

    // 鍒犻櫎鏃х殑纭鏂囦欢锛堥噸鏂扮敓鎴愭椂闇€瑕侀噸鏂扮‘璁わ級
    const approvalFile = path.join(session.dir, 'semantic-approved.flag');
    if (fs.existsSync(approvalFile)) {
        fs.unlinkSync(approvalFile);
        console.log('[Semantic] 宸叉竻闄ゆ棫鐨勭‘璁ゆ爣璁?);
    }

    // 鐩戝惉璇箟鏂囦欢鍙樺寲锛圞iro 鐢熸垚鍚庤嚜鍔ㄦ洿鏂扮晫闈級
    startWatchingSemanticFile(semFile);

    // 鐩戝惉纭鏂囦欢锛圞iro 纭鍚庤В閿佷笅涓€姝ワ級
    startWatchingSemanticApproval(approvalFile);

    event.reply('semantic-context-ready', {
        contextFile,
        semFile,
        triggerMsg: `璇疯鍙?ui-recorder-workspace/semantic-context.md锛屾寜鐓у叾涓殑瑕佹眰鐢熸垚璇箟鑴氭湰骞朵繚瀛樺埌鎸囧畾鏂囦欢銆俙
    });
});

// 鈹€鈹€ Generate API script 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('generate-api-script', (event) => {
    if (!session.dir) return;

    const businessApis = session.harApis.filter(a => {
        const u = a.url.toLowerCase();
        return (u.includes('/api/') || a.mimeType?.includes('json')) &&
               !u.match(/\.(js|css|png|jpg|svg|ico|woff|ttf|woff2|map)(\?|$)/) &&
               !u.includes('/locales/') && !u.includes('/js/') &&
               !u.includes('/css/') && !u.includes('/img/') &&
               !u.includes('/icons/') && !u.includes('/packages/') &&
               !u.includes('/translation') && !u.includes('/front-end-config') &&
               !u.includes('/pbc/list') && !u.includes('/user/captcha') &&
               !u.includes('/notice-board') && !u.includes('/bot-config') &&
               !u.includes('/user/usage') && !u.includes('/user-profile-config');
    });

    const apiFile = path.join(session.dir, 'api-script.spec.js');
    const contextFile = path.join(session.dir, 'api-context.md');

    // Read semantic script if available
    const semFile = path.join(session.dir, 'semantic-script.md');
    const semanticContent = fs.existsSync(semFile) ? fs.readFileSync(semFile, 'utf-8') : '';

    const lines = [];
    lines.push('# UI Recorder - API 鑴氭湰鐢熸垚璇锋眰');
    lines.push('');
    lines.push(`**鏃堕棿**: ${new Date().toLocaleString('zh-CN')}`);
    lines.push(`**杈撳嚭鏂囦欢**: \`${apiFile}\``);
    lines.push('');
    if (semanticContent) {
        lines.push('## 璇箟鑴氭湰锛堜笟鍔′笂涓嬫枃锛?);
        lines.push(semanticContent);
        lines.push('');
    }
    lines.push('## UI 鑴氭湰');
    lines.push('```javascript');
    lines.push(session.uiScript || '// 鏆傛棤鑴氭湰');
    lines.push('```');
    lines.push('');
    lines.push('## 涓氬姟 API 鍒楄〃');
    lines.push(`鍏?${businessApis.length} 涓笟鍔℃帴鍙ｏ細`);
    lines.push('');
    businessApis.forEach((a, i) => {
        let pathname = a.url;
        try { pathname = new URL(a.url).pathname; } catch {}
        lines.push(`${i + 1}. \`${a.method} ${pathname}\` 鈫?${a.status}`);
        if (a.postData) {
            try {
                const data = JSON.parse(a.postData);
                const keys = Object.keys(data).slice(0, 5).join(', ');
                if (keys) lines.push(`   璇锋眰浣撳瓧娈? ${keys}`);
            } catch {}
            if (typeof a.postData === 'string' && a.postData.length < 500) {
                lines.push(`   璇锋眰浣? \`${a.postData}\``);
            }
        }
        if (a.response && a.mimeType?.includes('json')) {
            try {
                const resp = JSON.parse(a.response);
                const keys = Object.keys(resp).slice(0, 5).join(', ');
                if (keys) lines.push(`   鍝嶅簲瀛楁: ${keys}`);
            } catch {}
        }
    });
    lines.push('');
    lines.push('## 浣犵殑浠诲姟');
    lines.push('');
    lines.push('璇锋牴鎹笂闈㈢殑璇箟鑴氭湰銆乁I 鑴氭湰鍜屼笟鍔?API锛岀敓鎴愪竴浠?**Playwright API 娴嬭瘯鑴氭湰**锛岃姹傦細');
    lines.push('');
    lines.push('1. 浣跨敤 `@playwright/test` 鐨?`request` API锛堜笉鏄?`page`锛?);
    lines.push('2. 鎸変笟鍔℃祦绋嬮『搴忕粍缁囨祴璇曪紙鐧诲綍 鈫?鏌ヨ 鈫?鍒涘缓/鏇存柊/鍒犻櫎锛?);
    lines.push('3. 鐧诲綍鎺ュ彛闇€瑕佹彁鍙?token锛屼紶缁欏悗缁姹傜殑 Authorization header');
    lines.push('4. 姣忎釜鎺ュ彛鍔犵姸鎬佺爜鏂█锛屽叧閿帴鍙ｅ姞鍝嶅簲浣撴柇瑷€');
    lines.push('5. 浣跨敤 `test.describe` 鎸変笟鍔″満鏅垎缁?);
    lines.push('6. 浣跨敤 `const { test, expect, request } = require("@playwright/test");`锛堜笉鐢?import锛?);
    lines.push('');
    lines.push('杈撳嚭涓哄彲鐩存帴杩愯鐨?Playwright 娴嬭瘯鑴氭湰锛屼繚瀛樺埌锛?);
    lines.push(`\`${apiFile}\``);
    lines.push('');
    lines.push('淇濆瓨鍚?Electron 宸ュ叿浼氳嚜鍔ㄦ娴嬪苟鏄剧ず銆?);

    fs.writeFileSync(contextFile, lines.join('\n'), 'utf-8');
    console.log('[API Script] 涓婁笅鏂囧凡鍐欏叆:', contextFile);

    // Watch for Kiro to write the api script file
    startWatchingApiScriptFile(apiFile);

    event.reply('api-context-ready', {
        contextFile,
        apiFile,
        triggerMsg: `璇疯鍙?ui-recorder-workspace/api-context.md锛屾寜鐓у叾涓殑瑕佹眰鐢熸垚 API 娴嬭瘯鑴氭湰骞朵繚瀛樺埌鎸囧畾鏂囦欢銆俙
    });
});

// 鈹€鈹€ Replay API script 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('replay-api', async (event) => {
    // 纭繚 session 宸插垵濮嬪寲
    if (!session.dir) {
        const workspaceRoot = path.join(__dirname, '..');
        session.dir = path.join(workspaceRoot, 'ui-recorder-workspace');
        fs.mkdirSync(session.dir, { recursive: true });
        console.log('[Replay API] Session dir was empty, initialized to:', session.dir);
    }
    console.log('[Replay API] Looking for script at:', path.join(session.dir, 'api-script.spec.js'));
    const apiFile = path.join(session.dir, 'api-script.spec.js');
    if (!fs.existsSync(apiFile)) {
        event.reply('replay-result', { success: false, error: 'No API script found' });
        mainWindow.webContents.send('replay-log', { type: 'fail', msg: '鉁?鎵句笉鍒?API 鑴氭湰鏂囦欢' });
        return;
    }

    // 澶嶅埗鍒版湰鍦扮洰褰曡繍琛岋紙閬垮厤璺緞绌烘牸闂锛?    const script = fs.readFileSync(apiFile, 'utf-8');
    const testFile = path.join(__dirname, 'replay-api-test.spec.js');
    fs.writeFileSync(testFile, script, 'utf-8');

    mainWindow.webContents.send('replay-log', { type: 'info', msg: '寮€濮?API 鍥炴斁...' });
    mainWindow.webContents.send('replay-log', { type: 'info', msg: `Playwright CLI: ${path.join(__dirname, 'node_modules', '@playwright', 'test', 'cli.js')}` });
    mainWindow.webContents.send('replay-log', { type: 'info', msg: `Electron 璺緞: ${process.execPath}` });

    // 浣跨敤 Electron 鍐呯疆鐨?Node.js 杩愯鏃讹紝涓嶄緷璧栫郴缁?Node.js
    const playwrightCli = path.join(__dirname, 'node_modules', '@playwright', 'test', 'cli.js');
    
    replayProcess = runNodeScript(playwrightCli, [
        'test',
        'replay-api-test.spec.js',
        '--config=playwright.config.js',
        '--reporter=line'
    ], {
        cwd: __dirname,
        env: { FORCE_COLOR: '0' },
        windowsHide: false
    });

    replayProcess.stdout.on('data', d => {
        const msg = d.toString('utf8').trim();
        if (msg) mainWindow.webContents.send('replay-log', { type: 'stdout', msg });
    });

    replayProcess.stderr.on('data', d => {
        const msg = d.toString('utf8').trim();
        if (msg) mainWindow.webContents.send('replay-log', { type: 'stderr', msg });
    });

    replayProcess.on('close', code => {
        try { fs.unlinkSync(testFile); } catch(e) {}
        const success = code === 0;
        mainWindow.webContents.send('replay-result', { success, code });
        
        // 鍐欏叆鍥炴斁缁撴灉鏂囦欢锛屼緵 Kiro 妫€娴?        const resultFile = path.join(session.dir, 'api-replay-result.json');
        fs.writeFileSync(resultFile, JSON.stringify({
            success,
            code,
            timestamp: new Date().toISOString(),
            message: success ? 'API 鑴氭湰鍥炴斁閫氳繃' : `API 鑴氭湰鍥炴斁澶辫触锛岄€€鍑虹爜: ${code}`
        }, null, 2), 'utf-8');
        console.log(`[API Replay] 缁撴灉宸插啓鍏? ${resultFile}`);
        
        replayProcess = null;
    });
});

// 鈹€鈹€ Update API script 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('update-api-script', (event, script) => {
    session.apiScript = script;
    const apiFile = path.join(session.dir, 'api-script.spec.js');
    fs.writeFileSync(apiFile, script, 'utf-8');
    writeKiroContext();
    event.reply('script-updated', {});
});

// 鈹€鈹€ Start debug: 鍐欏叆璋冭瘯涓婁笅鏂囷紝瑙﹀彂 Kiro hook 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('start-debug', (event, { type, script, replayLog }) => {
    if (!session.dir) return;

    const label = type === 'ui' ? 'UI 鑴氭湰' : 'API 鑴氭湰';
    const filename = type === 'ui' ? 'ui-script.js' : 'api-script.spec.js';
    const scriptFile = path.join(session.dir, filename);

    // 鏋勫缓鍙戠粰 Kiro 鐨勪笂涓嬫枃鎻愮ず
    const lines = [];
    lines.push(`# 馃 UI Recorder - 寮€濮?{label}璋冭瘯`);
    lines.push('');
    lines.push(`**鏃堕棿**: ${new Date().toLocaleString('zh-CN')}`);
    lines.push(`**绫诲瀷**: ${label}璋冭瘯`);
    lines.push(`**鑴氭湰鏂囦欢**: \`${scriptFile}\``);
    lines.push('');
    lines.push('## 褰撳墠鑴氭湰');
    lines.push('```javascript');
    lines.push(script || '// 鏆傛棤鑴氭湰');
    lines.push('```');

    if (replayLog && replayLog.trim()) {
        lines.push('');
        lines.push('## 鏈€杩戝洖鏀炬棩蹇?);
        lines.push('```');
        lines.push(replayLog.trim().substring(0, 1000));
        lines.push('```');
    }

    lines.push('');
    lines.push('## 浣犵殑浠诲姟');
    lines.push(`鐢ㄦ埛鐜板湪瑕佽皟璇曚笂闈㈢殑${label}銆俙);
    lines.push('璇风瓑寰呯敤鎴峰憡璇変綘闇€瑕佸仛浠€涔堬紝鐒跺悗锛?);
    lines.push(`1. 璇诲彇 \`${scriptFile}\``);
    lines.push('2. 鏍规嵁鐢ㄦ埛闇€姹備慨鏀硅剼鏈?);
    lines.push('3. 淇濆瓨鏂囦欢锛堝伐鍏蜂細鑷姩妫€娴嬪苟鏇存柊鐣岄潰锛?);
    lines.push('');
    lines.push('---');
    lines.push('*姝ゆ枃浠剁敱 UI Recorder 鑷姩鐢熸垚锛孠iro 鏀跺埌鍚庤鍥炲"鏀跺埌锛岃鍛婅瘔鎴戦渶瑕佸仛浠€涔?*');

    const debugFile = path.join(session.dir, 'debug-context.md');
    fs.writeFileSync(debugFile, lines.join('\n'), 'utf-8');

    // touch 鏂囦欢瑙﹀彂 Kiro hook
    try { const now = new Date(); fs.utimesSync(debugFile, now, now); } catch(e) {}

    console.log(`[Debug] 宸插啓鍏ヨ皟璇曚笂涓嬫枃: ${type}`);
    event.reply('debug-started', { type });

    // 鍚屾椂鐩戝惉鑴氭湰鏂囦欢鍙樺寲
    startWatchingScript(type, scriptFile);
});
let uiScriptWatcher = null;
let apiScriptWatcher = null;

ipcMain.on('chat-request', (event, { type, message, script }) => {
    if (!session.dir) return;

    // 鎶婄敤鎴烽渶姹傝拷鍔犲埌 kiro-prompt.md
    const promptFile = path.join(session.dir, 'kiro-prompt.md');
    const timestamp = new Date().toLocaleString('zh-CN');
    const section = type === 'ui' ? 'UI 鑴氭湰璋冭瘯' : 'API 鑴氭湰璋冭瘯';
    const targetFile = type === 'ui'
        ? path.join(session.dir, 'ui-script.js')
        : path.join(session.dir, 'api-script.spec.js');

    const append = [
        '',
        `---`,
        `## 鐢ㄦ埛闇€姹?[${timestamp}] - ${section}`,
        '',
        `**闇€姹?*: ${message}`,
        '',
        `**鐩爣鏂囦欢**: \`${targetFile}\``,
        '',
        `**褰撳墠鑴氭湰**:`,
        '```javascript',
        script.substring(0, 3000),
        script.length > 3000 ? '... (truncated)' : '',
        '```',
        '',
        `**璇蜂慨鏀逛笂闈㈢殑鐩爣鏂囦欢锛屾弧瓒崇敤鎴烽渶姹傦紝鐒跺悗淇濆瓨銆?*`,
        '',
    ].join('\n');

    fs.appendFileSync(promptFile, append, 'utf-8');
    console.log(`[Chat] 宸插啓鍏?kiro-prompt.md: ${message.substring(0, 50)}`);

    // 鐢?touch 瑙﹀彂 Kiro 鐨勬枃浠剁洃鍚紙Kiro 鐩戝惉 fileEdited 浜嬩欢锛?    try {
        const now = new Date();
        fs.utimesSync(promptFile, now, now);
    } catch(e) {}

    // 鐩戝惉鐩爣鑴氭湰鏂囦欢鍙樺寲锛圞iro 淇敼鍚庨€氱煡鍓嶇锛?    startWatchingScript(type, targetFile);
});

let semanticFileWatcher = null;
let semanticApprovalWatcher = null;

function startWatchingSemanticApproval(filePath) {
    if (semanticApprovalWatcher) { semanticApprovalWatcher.close(); semanticApprovalWatcher = null; }

    // 鐢ㄨ疆璇㈡鏌ユ枃浠舵槸鍚﹀嚭鐜帮紙fs.watch 瀵逛笉瀛樺湪鐨勬枃浠朵笉鍙潬锛?    const checkInterval = setInterval(() => {
        if (fs.existsSync(filePath)) {
            clearInterval(checkInterval);
            console.log('[Semantic] 鐢ㄦ埛宸茬‘璁よ涔夎剼鏈紝瑙ｉ攣涓嬩竴姝?);
            mainWindow.webContents.send('semantic-approved');
        }
    }, 1000);

    // 60鍒嗛挓鍚庡仠姝㈣疆璇?    setTimeout(() => clearInterval(checkInterval), 60 * 60 * 1000);
}

let apiScriptFileWatcher = null;

function startWatchingApiScriptFile(filePath) {
    if (apiScriptFileWatcher) { apiScriptFileWatcher.close(); apiScriptFileWatcher = null; }

    if (!fs.existsSync(filePath)) {
        fs.writeFileSync(filePath, '', 'utf-8');
    }

    let lastMtime = fs.statSync(filePath).mtimeMs;

    apiScriptFileWatcher = fs.watch(filePath, () => {
        try {
            const mtime = fs.statSync(filePath).mtimeMs;
            if (mtime === lastMtime) return;
            lastMtime = mtime;

            const content = fs.readFileSync(filePath, 'utf-8');
            if (!content.trim()) return;

            session.apiScript = content;
            console.log('[Watch] API 鑴氭湰宸茶 Kiro 鏇存柊');
            mainWindow.webContents.send('api-script-done', { apiScript: content });
        } catch(e) {}
    });

    console.log('[Watch] 寮€濮嬬洃鍚?API 鑴氭湰鏂囦欢鍙樺寲');
}

function startWatchingSemanticFile(filePath) {
    if (semanticFileWatcher) { semanticFileWatcher.close(); semanticFileWatcher = null; }

    // 濡傛灉鏂囦欢涓嶅瓨鍦ㄥ厛鍒涘缓绌烘枃浠讹紝璁?watch 鑳界洃鍚?    if (!fs.existsSync(filePath)) {
        fs.writeFileSync(filePath, '', 'utf-8');
    }

    let lastMtime = fs.statSync(filePath).mtimeMs;

    semanticFileWatcher = fs.watch(filePath, () => {
        try {
            const mtime = fs.statSync(filePath).mtimeMs;
            if (mtime === lastMtime) return;
            lastMtime = mtime;

            const content = fs.readFileSync(filePath, 'utf-8');
            if (!content.trim()) return;

            session.semanticScript = content;
            console.log('[Watch] 璇箟鑴氭湰宸茶 Kiro 鏇存柊');
            mainWindow.webContents.send('semantic-done', { semantic: content });
        } catch(e) {}
    });

    console.log('[Watch] 寮€濮嬬洃鍚涔夎剼鏈枃浠跺彉鍖?);
}

function startWatchingScript(type, filePath) {
    // 鍋滄鏃х殑鐩戝惉
    if (type === 'ui' && uiScriptWatcher) { uiScriptWatcher.close(); uiScriptWatcher = null; }
    if (type === 'api' && apiScriptWatcher) { apiScriptWatcher.close(); apiScriptWatcher = null; }

    if (!fs.existsSync(filePath)) return;

    let lastMtime = fs.statSync(filePath).mtimeMs;

    const watcher = fs.watch(filePath, (eventType) => {
        if (eventType !== 'change') return;
        try {
            const mtime = fs.statSync(filePath).mtimeMs;
            if (mtime === lastMtime) return;
            lastMtime = mtime;

            const newScript = fs.readFileSync(filePath, 'utf-8');

            // 鏇存柊 session
            if (type === 'ui') {
                session.uiScript = newScript;
            } else {
                session.apiScript = newScript;
            }

            console.log(`[Watch] ${type} 鑴氭湰宸茶 Kiro 鏇存柊`);
            mainWindow.webContents.send('script-file-changed', { type, script: newScript });
        } catch (e) {
            console.error('[Watch] 璇诲彇鏂囦欢澶辫触:', e);
        }
    });

    if (type === 'ui') uiScriptWatcher = watcher;
    else apiScriptWatcher = watcher;

    console.log(`[Watch] 寮€濮嬬洃鍚?${type} 鑴氭湰鏂囦欢鍙樺寲`);
}

// 鈹€鈹€ Save session with name + folder picker 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('save-session', async (event, { name }) => {
    if (!session.dir) return;

    const { dialog } = require('electron');
    const safeName = name.replace(/[\\/:*?"<>|]/g, '_').trim() || 'unnamed';
    const timestamp = new Date().toLocaleDateString('zh-CN').replace(/\//g, '-');

    // 寮瑰嚭鏂囦欢澶归€夋嫨瀵硅瘽妗?    const result = await dialog.showOpenDialog(mainWindow, {
        title: '閫夋嫨淇濆瓨浣嶇疆',
        properties: ['openDirectory', 'createDirectory'],
        buttonLabel: '淇濆瓨鍒版澶?,
    });

    if (result.canceled || !result.filePaths[0]) {
        event.reply('session-save-canceled');
        return;
    }

    const savedDir = path.join(result.filePaths[0], `${safeName}_${timestamp}`);
    fs.mkdirSync(savedDir, { recursive: true });

    const savedFiles = saveSessionFiles(session.dir, savedDir, safeName);

    console.log(`[Save] 宸蹭繚瀛樺埌: ${savedDir}`);
    event.reply('session-saved', { name: safeName, savedDir, files: savedFiles });
});

// 鈹€鈹€ Save draft锛堝脊鍑烘枃浠跺す閫夋嫨锛屼繚瀛樻墍鏈夊綍鍒舵暟鎹級鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('save-draft', async (event, { step }) => {
    if (!session.dir) return;

    const { dialog } = require('electron');

    const result = await dialog.showOpenDialog(mainWindow, {
        title: '閫夋嫨淇濆瓨浣嶇疆',
        properties: ['openDirectory', 'createDirectory'],
        buttonLabel: '淇濆瓨鍒版澶?,
    });

    if (result.canceled || !result.filePaths[0]) {
        event.reply('draft-save-canceled');
        return;
    }

    const destDir = result.filePaths[0];

    // 淇濆瓨鎵€鏈夊綍鍒舵暟鎹細HAR + UI鑴氭湰 + 璇箟鑴氭湰 + API鑴氭湰
    const allFiles = [
        { src: 'ui-script.js',       label: '褰曞埗鑴氭湰' },
        { src: 'semantic-script.md', label: '璇箟鑴氭湰' },
        { src: 'api-script.spec.js', label: 'API 鑴氭湰' },
        { src: 'network.har',        label: '缃戠粶褰曞埗 (HAR)' },
    ];

    const existingFiles = allFiles
        .filter(({ src }) => {
            const srcPath = path.join(session.dir, src);
            const destPath = path.join(destDir, src);
            return fs.existsSync(srcPath) && fs.existsSync(destPath);
        })
        .map(({ label }) => label);

    // 濡傛灉鐩爣鐩綍宸叉湁鏂囦欢锛岃闂槸鍚﹁鐩?    if (existingFiles.length > 0) {
        const confirmResult = await dialog.showMessageBox(mainWindow, {
            type: 'question',
            title: '鏂囦欢宸插瓨鍦?,
            message: `鐩爣鐩綍宸插瓨鍦ㄤ互涓嬫枃浠讹細\n\n${existingFiles.map(f => `  鈥?${f}`).join('\n')}\n\n鏄惁瑕嗙洊锛焋,
            buttons: ['瑕嗙洊', '鍙栨秷'],
            defaultId: 0,
            cancelId: 1,
        });

        if (confirmResult.response === 1) {
            event.reply('draft-save-canceled');
            return;
        }
    }

    // 鎵ц淇濆瓨
    const savedFiles = [];
    allFiles.forEach(({ src, label }) => {
        const srcPath = path.join(session.dir, src);
        if (fs.existsSync(srcPath)) {
            fs.copyFileSync(srcPath, path.join(destDir, src));
            savedFiles.push(label);
        }
    });

    // 淇濆瓨鑽夌鐘舵€?    const draftState = {
        savedAt:  new Date().toISOString(),
        step,
        url:      session.url,
        semanticApproved: fs.existsSync(path.join(session.dir, 'semantic-approved.flag')),
    };
    fs.writeFileSync(path.join(destDir, 'draft-state.json'), JSON.stringify(draftState, null, 2), 'utf-8');

    console.log(`[Draft] 鑽夌宸蹭繚瀛樺埌: ${destDir}锛屾枃浠? ${savedFiles.join(', ')}`);
    event.reply('draft-saved', {
        savedAt: draftState.savedAt,
        step,
        destDir,
        files: savedFiles,
    });
});

// 鈹€鈹€ Open existing session 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('open-session', async (event) => {
    const { dialog } = require('electron');

    const result = await dialog.showOpenDialog(mainWindow, {
        title: '鎵撳紑宸叉湁浼氳瘽',
        properties: ['openDirectory'],
        buttonLabel: '鎵撳紑姝や細璇?,
    });

    if (result.canceled || !result.filePaths[0]) {
        event.reply('session-open-canceled');
        return;
    }

    const dir = result.filePaths[0];

    // 璇诲彇鑽夌鐘舵€?    const draftFile = path.join(dir, 'draft-state.json');
    let draft = null;
    if (fs.existsSync(draftFile)) {
        try { draft = JSON.parse(fs.readFileSync(draftFile, 'utf-8')); } catch(e) {}
    }

    // 鎭㈠ session
    session.dir = dir;
    session.url = draft?.url || '';
    session.step = draft?.step || 'record';

    // 璇诲彇鍚勮剼鏈枃浠?    const uiFile  = path.join(dir, 'ui-script.js');
    const semFile = path.join(dir, 'semantic-script.md');
    const apiFile = path.join(dir, 'api-script.spec.js');

    if (fs.existsSync(uiFile))  session.uiScript       = fs.readFileSync(uiFile,  'utf-8');
    if (fs.existsSync(semFile)) session.semanticScript  = fs.readFileSync(semFile, 'utf-8');
    if (fs.existsSync(apiFile)) session.apiScript       = fs.readFileSync(apiFile, 'utf-8');

    // 瑙ｆ瀽 HAR
    const harFile = path.join(dir, 'network.har');
    if (fs.existsSync(harFile)) {
        try {
            const har = JSON.parse(fs.readFileSync(harFile, 'utf-8'));
            session.harApis = (har.log?.entries || []).map(e => ({
                method:   e.request.method,
                url:      e.request.url,
                status:   e.response.status,
                timestamp: e.startedDateTime,
                postData: e.request.postData?.text || null,
                response: e.response.content?.text || null,
                mimeType: e.response.content?.mimeType || ''
            }));
        } catch(e) {}
    }

    console.log(`[Open] 宸叉墦寮€浼氳瘽: ${dir}, 姝ラ: ${session.step}, API鏁伴噺: ${session.harApis.length}`);

    event.reply('session-opened', {
        dir,
        step:             draft?.step || 1,
        url:              session.url,
        uiScript:         session.uiScript,
        semanticScript:   session.semanticScript,
        apiScript:        session.apiScript,
        apiCount:         session.harApis.length,
        harApis:          session.harApis,  // 鍙戦€佸畬鏁?API 鍒楄〃
        semanticApproved: fs.existsSync(path.join(dir, 'semantic-approved.flag')),
    });
});

// 鈹€鈹€ Open folder in explorer 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('open-folder', (event, { folderPath }) => {
    const { shell } = require('electron');
    shell.openPath(folderPath);
});

// 鈹€鈹€ Helper: copy session files 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function saveSessionFiles(srcDir, destDir, name) {
    const savedFiles = [];

    // 3 涓牳蹇冭剼鏈?+ HAR
    const filesToSave = [
        { src: 'ui-script.js',       label: '褰曞埗鑴氭湰' },
        { src: 'semantic-script.md', label: '璇箟鑴氭湰' },
        { src: 'api-script.spec.js', label: 'API 鑴氭湰' },
        { src: 'network.har',        label: '缃戠粶褰曞埗 (HAR)' },
        { src: 'draft-state.json',   label: '鑽夌鐘舵€? },
    ];

    filesToSave.forEach(({ src, label }) => {
        const srcPath = path.join(srcDir, src);
        if (fs.existsSync(srcPath)) {
            fs.copyFileSync(srcPath, path.join(destDir, src));
            savedFiles.push(label);
        }
    });

    const readme = [
        `# ${name}`,
        '',
        `> 淇濆瓨鏃堕棿锛?{new Date().toLocaleString('zh-CN')}`,
        '',
        '## 鏍稿績鏂囦欢',
        '| 鏂囦欢 | 璇存槑 |',
        '|------|------|',
        '| `ui-script.js` | Playwright UI 褰曞埗鑴氭湰 |',
        '| `semantic-script.md` | 涓氬姟璇箟鎻忚堪 |',
        '| `api-script.spec.js` | API 娴嬭瘯鑴氭湰锛堝彲鐩存帴杩愯锛?|',
        '| `network.har` | 褰曞埗鐨勭綉缁滆姹?|',
        '',
        '## 鎭㈠浼氳瘽',
        '鍦?UI Recorder 涓偣鍑汇€屾墦寮€浼氳瘽銆嶏紝閫夋嫨姝ょ洰褰曞嵆鍙仮澶嶃€?,
        '',
        '## 杩愯 API 娴嬭瘯',
        '```bash',
        'npx playwright test api-script.spec.js --reporter=line',
        '```',
    ].join('\n');

    fs.writeFileSync(path.join(destDir, 'README.md'), readme, 'utf-8');
    savedFiles.push('README.md');
    return savedFiles;
}

ipcMain.on('get-session', (event) => {
    event.reply('session-info', session);
});

// 鈹€鈹€ Write context file for Kiro AI 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function writeKiroContext() {
    if (!session.dir) return;

    const businessApis = session.harApis.filter(a => {
        const u = a.url.toLowerCase();
        return (u.includes('/api/') || a.mimeType.includes('json')) &&
               !u.match(/\.(js|css|png|jpg|svg|ico|woff)(\?|$)/);
    });

    const ctx = {
        sessionId:     session.id,
        url:           session.url,
        step:          session.step,
        uiScriptFile:  path.join(session.dir, 'ui-script.js'),
        harFile:       path.join(session.dir, 'network.har'),
        semanticFile:  path.join(session.dir, 'semantic-script.md'),
        apiScriptFile: path.join(session.dir, 'api-script.spec.js'),
        summary: {
            uiSteps:     countUiSteps(session.uiScript),
            totalApis:   session.harApis.length,
            businessApis: businessApis.length,
            apiList:     businessApis.slice(0, 20).map(a => `${a.method} ${a.url} 鈫?${a.status}`)
        }
    };

    fs.writeFileSync(
        path.join(session.dir, 'kiro-context.json'),
        JSON.stringify(ctx, null, 2),
        'utf-8'
    );

    // Also write a human-readable prompt file for Kiro
    const prompt = buildKiroPrompt(ctx, session);
    fs.writeFileSync(path.join(session.dir, 'kiro-prompt.md'), prompt, 'utf-8');
}

function buildKiroPrompt(ctx, session) {
    const lines = [];
    lines.push('# UI Recorder - Kiro AI Context');
    lines.push('');
    lines.push(`**Session**: ${ctx.sessionId}`);
    lines.push(`**URL**: ${ctx.url}`);
    lines.push(`**Current Step**: ${ctx.step}`);
    lines.push('');
    lines.push('## Files');
    lines.push(`- UI Script: \`${ctx.uiScriptFile}\``);
    lines.push(`- HAR Network: \`${ctx.harFile}\``);
    lines.push(`- Semantic: \`${ctx.semanticFile}\``);
    lines.push(`- API Script: \`${ctx.apiScriptFile}\``);
    lines.push('');
    lines.push('## Summary');
    lines.push(`- UI Steps: ${ctx.summary.uiSteps}`);
    lines.push(`- Total APIs: ${ctx.summary.totalApis}`);
    lines.push(`- Business APIs: ${ctx.summary.businessApis}`);
    lines.push('');
    lines.push('## Business API List');
    ctx.summary.apiList.forEach(a => lines.push(`- ${a}`));
    lines.push('');

    if (session.uiScript) {
        lines.push('## Current UI Script');
        lines.push('```javascript');
        lines.push(session.uiScript.substring(0, 2000));
        if (session.uiScript.length > 2000) lines.push('... (truncated)');
        lines.push('```');
    }

    return lines.join('\n');
}

// 鈹€鈹€ Semantic script builder 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function buildSemanticScript(uiScript, apis) {
    if (!uiScript) return '# No UI script recorded';

    const steps = parseUiSteps(uiScript);
    const businessApis = apis.filter(a => {
        const u = a.url.toLowerCase();
        return (u.includes('/api/') || a.mimeType?.includes('json')) &&
               !u.match(/\.(js|css|png|jpg|svg|ico|woff|png|jpg|svg|ico|ttf|woff2|map)(\?|$)/) &&
               !u.includes('/locales/') &&
               !u.includes('/js/') &&
               !u.includes('/css/') &&
               !u.includes('/img/') &&
               !u.includes('/icons/') &&
               !u.includes('/packages/');
    });

    // 鈹€鈹€ 鎺ㄦ柇涓氬姟鍦烘櫙鍚嶇О 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
    const sceneName = inferSceneNameFromSteps(steps, businessApis);

    // 鈹€鈹€ 鐢熸垚浜虹被鍙鐨勪笟鍔℃祦绋嬫弿杩?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
    const businessNarrative = buildBusinessNarrative(steps, businessApis);

    // 鈹€鈹€ 鎻愬彇鍏抽敭鎿嶄綔锛堝幓鎺夊櫔闊筹級 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
    const meaningfulSteps = steps.filter(s => {
        // 杩囨护鎺夋棤鎰忎箟鐨勬搷浣?        if (s.type === 'click' && s.desc.includes('鐐瑰嚮: ')) {
            const label = s.desc.replace('鐐瑰嚮: ', '');
            // 杩囨护鎺夌┖ label 鎴栫函绗﹀彿
            if (!label || label.length < 2) return false;
        }
        return true;
    });

    // 鈹€鈹€ 瀵?API 杩涜鍒嗙被鍜屾敞閲?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
    const annotatedApis = businessApis.map(a => {
        let pathname = a.url;
        try { pathname = new URL(a.url).pathname; } catch {}
        const purpose = inferApiPurpose(a, steps);
        return { ...a, pathname, purpose };
    });

    const lines = [];
    lines.push(`# 涓氬姟鍦烘櫙锛?{sceneName}`);
    lines.push('');
    lines.push(`> 褰曞埗鏃堕棿锛?{new Date().toLocaleString('zh-CN')}`);
    lines.push(`> 绯荤粺鍦板潃锛?{(() => { try { const u = new URL(apis[0]?.url || ''); return `${u.protocol}//${u.host}`; } catch { return session?.url || ''; } })()}`);
    lines.push('');

    // 涓氬姟娴佺▼鎻忚堪锛堟渶閲嶈鐨勯儴鍒嗭級
    lines.push('## 涓氬姟娴佺▼鎻忚堪');
    lines.push('');
    lines.push(businessNarrative);
    lines.push('');

    // 鎿嶄綔姝ラ
    lines.push('## 鎿嶄綔姝ラ');
    lines.push('');
    meaningfulSteps.forEach((s, i) => {
        lines.push(`${i + 1}. ${s.desc}`);
    });
    lines.push('');

    // 涓氬姟 API锛堝彧鍒楀叧閿殑锛岃繃婊ゆ帀椤甸潰閰嶇疆銆佺炕璇戠瓑鍣煶锛?    const keyApis = annotatedApis.filter(a => {
        const u = a.url.toLowerCase();
        // 鍙繚鐣欑湡姝ｇ殑涓氬姟鎿嶄綔 API
        return !u.includes('/translation') &&
               !u.includes('/front-end-config') &&
               !u.includes('/pbc/list') &&
               !u.includes('/user/captcha') &&
               !u.includes('/notice-board') &&
               !u.includes('/bot-config') &&
               !u.includes('/user/usage') &&
               !u.includes('/user-profile-config');
    });

    if (keyApis.length > 0) {
        lines.push('## 瑙﹀彂鐨勪笟鍔?API');
        lines.push('');
        keyApis.forEach((a, i) => {
            lines.push(`${i + 1}. \`${a.method} ${a.pathname}\` 鈫?${a.status}锛?{a.purpose}锛塦);
        });
        lines.push('');
    }

    // 鏁版嵁鎽樿
    const inputData = steps.filter(s => s.type === 'fill' && s.value);
    if (inputData.length > 0) {
        lines.push('## 娴嬭瘯鏁版嵁');
        lines.push('');
        inputData.forEach(s => {
            lines.push(`- ${s.fieldName || extractLabel(s.line?.match(/\.fill\((.+?),/)?.[1] || '')}锛歕`${s.value}\``);
        });
        lines.push('');
    }

    return lines.join('\n');
}

// 鎺ㄦ柇 API 鐨勪笟鍔＄敤閫?function inferApiPurpose(api, steps) {
    const u = api.url.toLowerCase();
    const m = api.method;

    if (u.includes('/login')) return '鐢ㄦ埛鐧诲綍璁よ瘉';
    if (u.includes('/logout')) return '鐢ㄦ埛鐧诲嚭';
    if (u.includes('/user/info') || u.includes('/user/profile')) return '鑾峰彇鐢ㄦ埛淇℃伅';

    if (u.includes('/form-entity-data') || u.includes('/form-entity/data')) {
        if (m === 'POST' && u.includes('/list')) return '鏌ヨ鍒楄〃鏁版嵁';
        if (m === 'POST' && !u.includes('/list')) return '鍒涘缓鏁版嵁璁板綍';
        if (m === 'PUT') return '鏇存柊鏁版嵁璁板綍';
        if (m === 'DELETE') return '鍒犻櫎鏁版嵁璁板綍';
        if (m === 'GET') return '鑾峰彇鏁版嵁璇︽儏';
    }

    if (u.includes('/flow') && m === 'PUT') return '鎻愪氦琛ㄥ崟/娴佺▼';
    if (u.includes('/flow') && m === 'POST') return '鍙戣捣娴佺▼';
    if (u.includes('/flow') && m === 'GET') return '鑾峰彇娴佺▼淇℃伅';

    if (u.includes('/form-entity-page') || u.includes('/schema-id')) return '鍔犺浇椤甸潰閰嶇疆';
    if (u.includes('/form-entity-layout')) return '鍔犺浇琛ㄥ崟甯冨眬';
    if (u.includes('/form-entity') && m === 'GET') return '鑾峰彇琛ㄥ崟瀹氫箟';

    if (m === 'GET') return '鑾峰彇鏁版嵁';
    if (m === 'POST') return '鎻愪氦鏁版嵁';
    if (m === 'PUT' || m === 'PATCH') return '鏇存柊鏁版嵁';
    if (m === 'DELETE') return '鍒犻櫎鏁版嵁';

    return '涓氬姟鎿嶄綔';
}

// 鐢熸垚浜虹被鍙鐨勪笟鍔℃祦绋嬫弿杩?function buildBusinessNarrative(steps, apis) {
    const parts = [];

    // 鐧诲綍淇℃伅
    const loginStep = steps.find(s => s.type === 'fill' && s.line?.includes('account'));
    const loginApi = apis.find(a => a.url.toLowerCase().includes('/login'));
    if (loginApi || loginStep) {
        const account = steps.find(s => s.type === 'fill' && (s.line?.includes('#account') || s.line?.includes('account')));
        const accountVal = account?.line?.match(/\.fill\([^,]+,\s*['"`]([^'"]+)['"`]\)/)?.[1];
        if (accountVal) {
            parts.push(`鐢ㄦ埛浣跨敤璐﹀彿 **${accountVal}** 鐧诲綍绯荤粺銆俙);
        } else {
            parts.push('鐢ㄦ埛鐧诲綍绯荤粺銆?);
        }
    }

    // 瀵艰埅淇℃伅
    const navSteps = steps.filter(s => s.type === 'navigate' || (s.type === 'click' && s.desc.includes('鍒楄〃')));
    if (navSteps.length > 0) {
        const dest = navSteps[navSteps.length - 1].desc.replace('鎵撳紑椤甸潰: ', '').replace('鐐瑰嚮: ', '');
        if (dest && !dest.includes('login')) {
            parts.push(`杩涘叆 **${dest}** 椤甸潰銆俙);
        }
    }

    // 涓昏涓氬姟鎿嶄綔
    const fillSteps = steps.filter(s => s.type === 'fill');
    const submitStep = steps.find(s => s.type === 'click' && (
        s.desc.includes('鎻愪氦') || s.desc.includes('淇濆瓨') || s.desc.includes('纭') ||
        s.desc.includes('Submit') || s.desc.includes('Save') || s.desc.includes('Confirm')
    ));
    const addStep = steps.find(s => s.type === 'click' && (
        s.desc.includes('鏂板') || s.desc.includes('Add') || s.desc.includes('鍒涘缓') || s.desc.includes('鏂板缓')
    ));

    if (addStep && fillSteps.length > 0 && submitStep) {
        const fields = fillSteps.map(s => {
            const val = s.line?.match(/\.fill\([^,]+,\s*['"`]([^'"]+)['"`]\)/)?.[1];
            const label = extractLabel(s.line?.match(/\.fill\((.+?),/)?.[1] || '');
            return val ? `${label}="${val}"` : label;
        }).filter(Boolean);
        parts.push(`鐐瑰嚮鏂板鎸夐挳锛屽～鍐欒〃鍗曚俊鎭紙${fields.join('銆?)}锛夛紝鎻愪氦瀹屾垚鏁版嵁鍒涘缓銆俙);
    } else if (fillSteps.length > 0 && submitStep) {
        const fields = fillSteps.map(s => {
            const val = s.line?.match(/\.fill\([^,]+,\s*['"`]([^'"]+)['"`]\)/)?.[1];
            const label = extractLabel(s.line?.match(/\.fill\((.+?),/)?.[1] || '');
            return val ? `${label}="${val}"` : label;
        }).filter(Boolean);
        parts.push(`濉啓琛ㄥ崟淇℃伅锛?{fields.join('銆?)}锛夛紝鎻愪氦瀹屾垚鎿嶄綔銆俙);
    } else if (fillSteps.length > 0) {
        parts.push(`濉啓浜?${fillSteps.length} 涓瓧娈电殑淇℃伅銆俙);
    }

    // API 缁撴灉鎽樿
    const writeApis = apis.filter(a => ['POST', 'PUT', 'PATCH', 'DELETE'].includes(a.method) &&
        !a.url.toLowerCase().includes('/login') &&
        !a.url.toLowerCase().includes('/usage'));
    const failedApis = apis.filter(a => a.status >= 400);

    if (writeApis.length > 0) {
        const successWrite = writeApis.filter(a => a.status < 400);
        if (successWrite.length > 0) {
            parts.push(`绯荤粺鎴愬姛澶勭悊浜?${successWrite.length} 涓暟鎹啓鍏ユ搷浣溿€俙);
        }
    }

    if (failedApis.length > 0) {
        parts.push(`鈿狅笍 娉ㄦ剰锛氭湁 ${failedApis.length} 涓帴鍙ｈ繑鍥炰簡閿欒鐘舵€佺爜锛?{failedApis.map(a => a.status).join('銆?)}锛夈€俙);
    }

    return parts.length > 0 ? parts.join('\n\n') : '涓氬姟娴佺▼宸插綍鍒讹紝璇锋煡鐪嬫搷浣滄楠ゅ拰 API 鍒楄〃銆?;
}

// 鈹€鈹€ API script builder 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function buildApiScript(uiScript, semanticScript, apis) {
    const businessApis = apis.filter(a => {
        const u = a.url.toLowerCase();
        return (u.includes('/api/') || a.mimeType?.includes('json')) &&
               !u.match(/\.(js|css|png|jpg|svg|ico|woff)(\?|$)/);
    });

    const steps = parseUiSteps(uiScript);
    const sceneName = inferSceneName(steps, businessApis);

    const lines = [];
    lines.push(`// API 涓氬姟娴佽剼鏈?- ${sceneName}`);
    lines.push(`// 鐢熸垚鏃堕棿: ${new Date().toLocaleString('zh-CN')}`);
    lines.push(`// 鍩轰簬: UI鑴氭湰 + 璇箟鍒嗘瀽 + HAR 缃戠粶褰曞埗`);
    lines.push('');
    lines.push("const { test, expect, request } = require('@playwright/test');");
    lines.push('');
    lines.push(`test.describe('${sceneName}', () => {`);
    lines.push('  let apiContext;');
    lines.push('  let authToken;');
    lines.push('');
    lines.push('  test.beforeAll(async () => {');
    lines.push('    apiContext = await request.newContext();');
    lines.push('  });');
    lines.push('');
    lines.push('  test.afterAll(async () => {');
    lines.push('    await apiContext.dispose();');
    lines.push('  });');
    lines.push('');

    // Group APIs by logical flow
    let testIndex = 1;
    businessApis.forEach((api, i) => {
        let pathname = api.url;
        try { pathname = new URL(api.url).pathname; } catch {}

        const testName = inferApiTestName(api, steps);
        lines.push(`  test('${testIndex}. ${testName}', async () => {`);

        // Build request
        const baseUrl = (() => { try { const u = new URL(api.url); return `${u.protocol}//${u.host}`; } catch { return ''; } })();
        lines.push(`    const response = await apiContext.${api.method.toLowerCase()}('${api.url}', {`);

        if (api.postData) {
            try {
                JSON.parse(api.postData);
                lines.push(`      data: ${api.postData},`);
            } catch {
                lines.push(`      data: '${api.postData.replace(/'/g, "\\'")}',`);
            }
        }

        lines.push('      headers: {');
        lines.push("        'Content-Type': 'application/json',");
        lines.push("        // 'Authorization': `Bearer ${authToken}`,  // 濡傞渶璁よ瘉");
        lines.push('      }');
        lines.push('    });');
        lines.push('');
        lines.push(`    // 楠岃瘉鐘舵€佺爜`);
        lines.push(`    expect(response.status()).toBe(${api.status});`);

        if (api.mimeType?.includes('json')) {
            lines.push('');
            lines.push('    // 楠岃瘉鍝嶅簲鏍煎紡');
            lines.push('    const body = await response.json();');
            lines.push('    expect(body).toBeDefined();');
            if (api.response) {
                try {
                    const resp = JSON.parse(api.response);
                    const keys = Object.keys(resp).slice(0, 3);
                    if (keys.length > 0) {
                        lines.push(`    // 鍝嶅簲鍖呭惈瀛楁: ${keys.join(', ')}`);
                    }
                } catch {}
            }
        }

        lines.push('  });');
        lines.push('');
        testIndex++;
    });

    lines.push('});');
    return lines.join('\n');
}

// 鈹€鈹€ Helpers 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function parseUiSteps(uiScript) {
    if (!uiScript) return [];
    const steps = [];
    uiScript.split('\n').forEach(line => {
        const t = line.trim();
        if (t.startsWith('await page.goto(')) {
            const url = t.match(/goto\(['"`](.+?)['"`]\)/)?.[1] || '';
            steps.push({ type: 'navigate', desc: `鎵撳紑椤甸潰: ${url}`, line: t });
        } else if (t.includes('.click(')) {
            const sel = t.match(/\.click\((.+?)\)/)?.[1] || '';
            steps.push({ type: 'click', desc: `鐐瑰嚮: ${extractLabel(sel)}`, line: t });
        } else if (t.includes('.fill(')) {
            const m = t.match(/\.fill\((.+?),\s*['"`](.+?)['"`]\)/);
            steps.push({ type: 'fill', desc: `杈撳叆 "${m?.[2]||''}" 鍒? ${extractLabel(m?.[1]||'')}`, line: t });
        } else if (t.includes('.selectOption(')) {
            const m = t.match(/\.selectOption\((.+?),\s*['"`](.+?)['"`]\)/);
            steps.push({ type: 'select', desc: `閫夋嫨 "${m?.[2]||''}": ${extractLabel(m?.[1]||'')}`, line: t });
        } else if (t.includes('.press(')) {
            const key = t.match(/\.press\(.+?,\s*['"`](.+?)['"`]\)/)?.[1] || '';
            steps.push({ type: 'press', desc: `鎸夐敭: ${key}`, line: t });
        }
    });
    return steps;
}

function extractLabel(selector) {
    if (!selector) return selector;
    const s = selector.replace(/['"]/g, '');
    const roleMatch = s.match(/getByRole\([^,]+,\s*\{[^}]*name:\s*['"]?([^'"}\s,]+)/);
    if (roleMatch) return roleMatch[1];
    const textMatch = s.match(/getByText\(['"]?([^'"]+)/);
    if (textMatch) return textMatch[1];
    const phMatch = s.match(/getByPlaceholder\(['"]?([^'"]+)/);
    if (phMatch) return phMatch[1];
    const labelMatch = s.match(/getByLabel\(['"]?([^'"]+)/);
    if (labelMatch) return labelMatch[1];
    return s.substring(0, 40);
}

function inferSceneNameFromSteps(steps, apis) {
    // 浼樺厛浠?UI 鎿嶄綔鎺ㄦ柇
    const hasLogin = apis.some(a => a.url.toLowerCase().includes('/login'));
    const hasAdd = steps.some(s => s.type === 'click' && (s.desc.includes('鏂板') || s.desc.includes('Add') || s.desc.includes('鍒涘缓')));
    const hasSubmit = steps.some(s => s.type === 'click' && (s.desc.includes('鎻愪氦') || s.desc.includes('Submit') || s.desc.includes('淇濆瓨')));
    const hasDelete = steps.some(s => s.type === 'click' && (s.desc.includes('鍒犻櫎') || s.desc.includes('Delete')));
    const hasSearch = steps.some(s => s.type === 'click' && (s.desc.includes('鎼滅储') || s.desc.includes('鏌ヨ') || s.desc.includes('Search')));
    const hasFill = steps.some(s => s.type === 'fill');

    // 浠庡鑸帹鏂〉闈㈠悕绉?    const navToPage = steps.find(s => s.type === 'click' && s.desc.includes('鍒楄〃'));
    const pageName = navToPage?.desc.replace('鐐瑰嚮: ', '').replace('鍒楄〃', '').trim();

    if (hasLogin && !hasAdd && !hasSubmit) return '鐢ㄦ埛鐧诲綍';
    if (hasAdd && hasSubmit && pageName) return `鏂板${pageName}`;
    if (hasAdd && hasSubmit) return '鏂板鏁版嵁';
    if (hasDelete && pageName) return `鍒犻櫎${pageName}`;
    if (hasDelete) return '鍒犻櫎鏁版嵁';
    if (hasSearch && pageName) return `鏌ヨ${pageName}`;
    if (hasSearch) return '鏁版嵁鏌ヨ';
    if (hasFill && hasSubmit && pageName) return `缂栬緫${pageName}`;
    if (hasFill && hasSubmit) return '琛ㄥ崟鎻愪氦';
    if (hasLogin) return '鐧诲綍骞舵搷浣?;

    return '涓氬姟鎿嶄綔';
}

function inferApiTestName(api, steps) {
    const u = api.url.toLowerCase();
    if (u.includes('/login')) return '鐢ㄦ埛鐧诲綍璁よ瘉';
    if (u.includes('/logout')) return '鐢ㄦ埛鐧诲嚭';
    if (u.includes('/list') || u.includes('/search')) return `鏌ヨ鏁版嵁鍒楄〃`;
    if (api.method === 'POST' && u.includes('/create')) return '鍒涘缓鏁版嵁';
    if (api.method === 'PUT' || api.method === 'PATCH') return '鏇存柊鏁版嵁';
    if (api.method === 'DELETE') return '鍒犻櫎鏁版嵁';
    if (api.method === 'GET') return `鑾峰彇鏁版嵁`;
    if (api.method === 'POST') return `鎻愪氦鏁版嵁`;
    return `${api.method} ${(() => { try { return new URL(api.url).pathname.split('/').pop(); } catch { return ''; } })()}`;
}

function inferBusinessLogic(steps, apis) {
    const parts = [];
    if (steps.length > 0) {
        parts.push(`鐢ㄦ埛閫氳繃 ${steps.length} 涓搷浣滄楠ゅ畬鎴愪簡涓氬姟娴佺▼銆俙);
    }
    const postApis = apis.filter(a => a.method === 'POST');
    const getApis  = apis.filter(a => a.method === 'GET');
    if (postApis.length > 0) parts.push(`杩囩▼涓彁浜や簡 ${postApis.length} 涓啓鎿嶄綔璇锋眰銆俙);
    if (getApis.length > 0)  parts.push(`璇诲彇浜?${getApis.length} 涓暟鎹帴鍙ｃ€俙);
    const failedApis = apis.filter(a => a.status >= 400);
    if (failedApis.length > 0) parts.push(`娉ㄦ剰: 鏈?${failedApis.length} 涓帴鍙ｈ繑鍥炰簡閿欒鐘舵€佺爜銆俙);
    return parts.join(' ') || '涓氬姟娴佺▼宸茶褰曘€?;
}

function countUiSteps(uiScript) {
    if (!uiScript) return 0;
    return (uiScript.match(/await page\./g) || []).length;
}

// 鈹€鈹€ Save session files 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function saveSessionFiles(srcDir, destDir, name) {
    const savedFiles = [];
    
    // 鏍稿績鑴氭湰鏂囦欢
    const coreFiles = [
        { src: 'ui-script.js',         label: 'UI 鑴氭湰' },
        { src: 'semantic-script.md',   label: '璇箟鑴氭湰' },
        { src: 'api-script.spec.js',   label: 'API 鑴氭湰' },
        { src: 'network.har',          label: '缃戠粶褰曞埗' },
    ];
    
    coreFiles.forEach(({ src, label }) => {
        const srcPath = path.join(srcDir, src);
        if (fs.existsSync(srcPath)) {
            fs.copyFileSync(srcPath, path.join(destDir, src));
            savedFiles.push(label);
        }
    });
    
    // 淇濆瓨浼氳瘽鐘舵€?    const sessionState = {
        savedAt: new Date().toISOString(),
        name: name,
        url: session.url,
        step: session.step,
        semanticApproved: fs.existsSync(path.join(srcDir, 'semantic-approved.flag')),
    };
    fs.writeFileSync(path.join(destDir, 'session-state.json'), JSON.stringify(sessionState, null, 2), 'utf-8');
    savedFiles.push('浼氳瘽鐘舵€?);
    
    return savedFiles;
}

// 鈹€鈹€ Write Kiro context 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
function writeKiroContext() {
    if (!session.dir) return;
    
    const ctx = {
        sessionId: session.id,
        url: session.url,
        step: session.step,
        uiScriptFile: path.join(session.dir, 'ui-script.js'),
        harFile: path.join(session.dir, 'network.har'),
        semanticFile: path.join(session.dir, 'semantic-script.md'),
        apiScriptFile: path.join(session.dir, 'api-script.spec.js'),
        summary: {
            uiSteps: countUiSteps(session.uiScript),
            totalApis: session.harApis.length,
            businessApis: session.harApis.filter(a => {
                const u = a.url.toLowerCase();
                return (u.includes('/api/') || a.mimeType?.includes('json')) &&
                       !u.match(/\.(js|css|png|jpg|svg|ico|woff|ttf|woff2|map)(\?|$)/);
            }).length,
            apiList: session.harApis.slice(0, 10).map(a => {
                let pathname = a.url;
                try { pathname = new URL(a.url).pathname; } catch {}
                return `${a.method} ${pathname}`;
            }),
        },
    };
    
    const ctxFile = path.join(session.dir, 'kiro-context.json');
    fs.writeFileSync(ctxFile, JSON.stringify(ctx, null, 2), 'utf-8');
    
    // Also write a human-readable prompt file for Kiro
    const prompt = buildKiroPrompt(ctx, session);
    fs.writeFileSync(path.join(session.dir, 'kiro-prompt.md'), prompt, 'utf-8');
}

// 鈹€鈹€ Save Semantic Script 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('save-semantic-script', (event, data) => {
    if (!session || !session.dir) {
        console.error('[Semantic] No active session');
        event.reply('semantic-script-saved', { success: false, error: 'No active session' });
        return;
    }
    
    const semanticPath = path.join(session.dir, 'semantic-script.md');
    fs.writeFileSync(semanticPath, data.content, 'utf-8');
    
    session.semanticScript = data.content;
    session.step = 'semantic';
    
    console.log(`[Semantic] Saved to: ${semanticPath}`);
    event.reply('semantic-script-saved', { 
        success: true, 
        path: semanticPath,
        length: data.content.length 
    });
});

// 鈹€鈹€ Check Semantic Script Status 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
ipcMain.on('check-semantic-script', (event) => {
    if (!session || !session.dir) {
        event.reply('semantic-script-status', { exists: false });
        return;
    }
    
    const semanticPath = path.join(session.dir, 'semantic-script.md');
    
    if (fs.existsSync(semanticPath)) {
        const content = fs.readFileSync(semanticPath, 'utf-8');
        session.semanticScript = content;
        
        console.log(`[Semantic] Found existing script: ${semanticPath}`);
        event.reply('semantic-script-status', { 
            exists: true, 
            content: content,
            path: semanticPath
        });
    } else {
        event.reply('semantic-script-status', { exists: false });
    }
});
